{
  "name": "dsh-mobile-adapt",
  "version": "1.9.4",
  "private": false,
  "description": "侧栏变抽屉、手势开关、宽度可调、键盘不挡输入框、字号不小于 15px。把电脑版界面调成适合手指用的样子。A mobile-friendly layer for DSH Web: swipe drawer sidebar, adjustable width, keyboard avoidance and a readable font floor.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-mobile",
    "deepseek-harness",
    "deepseek",
    "mobile",
    "android",
    "phone",
    "sidebar",
    "drawer",
    "swipe",
    "gesture",
    "touch",
    "font-size",
    "responsive",
    "mobile-ui",
    "移动端适配",
    "手机端",
    "侧边栏",
    "手势"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "dsh-mobile-adapt contributors"
}
